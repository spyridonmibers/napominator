<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/n_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="14sp" />
    <ProgressBar
        android:id="@+id/n_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:id="@+id/n_row0"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/n_dot0"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/w_dot" />
        <TextView
            android:id="@+id/n_title0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/n_check0"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/w_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_row1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/n_dot1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/w_dot" />
        <TextView
            android:id="@+id/n_title1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/n_check1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/w_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_row2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/n_dot2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/w_dot" />
        <TextView
            android:id="@+id/n_title2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/n_check2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/w_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_row3"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/n_dot3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/w_dot" />
        <TextView
            android:id="@+id/n_title3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/n_check3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/w_check_off" />
    </LinearLayout>


    <TextView
        android:id="@+id/n_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
